---
/**
 * The pop-up's quiz, details and call, one page per studio: /start/<studio>/?path=speak|info
 *
 * It opens inside the pop-up (components/StartChooser.astro) in a frame, and works on its own too. It is a page of its
 * own for one reason: it loads ONLY this studio's GHL External Tracking, so the form lands in this studio's GHL and
 * nowhere else. The site's all-studio pages load all three trackers (the contact form needs them), and a form there
 * would make a contact in every studio.
 *
 * The flow is the ad landing pages' (join.blueprintfitnessldn.com), so the follow-up is the same:
 *   speak: the three questions > your details (sent) > a time for a call with a coach (where the studio has a call
 *          calendar; all three since 26 Nov 2026) > done
 *   info:  the three questions > your details > message or a call? (sent) > done
 * "Sent" is GHL External Tracking reading the form as website-<studio>, which starts the studio's "New Lead - Main
 * Website (Nov 2026)" workflow. Enquiry: Path says which way they came; the workflow routes on it.
 * The call step books through /api/slots and /api/book, the funnel's Worker, routed to this domain.
 */
import '../../styles/main.css';
import { studios } from '../../data/studios';
import { questions, PATH, callCalendar, formName } from '../../data/startFlow';

export async function getStaticPaths() {
  return studios.map((studio) => ({ params: { studio: studio.slug }, props: { studio } }));
}
const { studio } = Astro.props;
const form = formName(studio.slug);
const offer = '30-Day Kickstart';
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Start your 30 days at Blueprint Fitness {studio.name}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@700;800&family=Montserrat:wght@100..900&display=swap" />
</head>
<body class="sf-body">
<main class="sf">
  <div class="sf-head">
    <button class="sf-back" type="button" hidden>&larr; Back</button>
    <span class="sf-bar"><i></i></span><span class="sf-count"></span>
  </div>

  <form class="sf-form" id={form} name={form} data-studio={studio.slug} data-cal={callCalendar[studio.slug] ? '1' : ''} method="POST" novalidate>
    {questions.map((q) => (
      <fieldset data-step={q.key} data-q={q.key} data-field={q.field}>
        <legend>{q.q}</legend>
        <div class="sf-opts">
          {q.options.map((o) => (
            <label class="sf-opt"><input type="radio" data-name={q.key} value={o.a} data-id={o.id} data-bucket={o.bucket ?? ''} /><span>{o.a}</span></label>
          ))}
        </div>
      </fieldset>
    ))}

    <fieldset data-step="details" hidden>
      <legend>Where&rsquo;s best to get in touch?</legend>
      <p class="sf-sub" data-for="speak">We&rsquo;ll only use these to arrange your call and tell you about the {offer} at Blueprint Fitness {studio.name}.</p>
      <p class="sf-sub" data-for="info" hidden>We&rsquo;ll only use these to get back to you about the {offer} at Blueprint Fitness {studio.name}.</p>
      <div class="sf-two">
        <div class="field"><label for="f-first">First name</label><input id="f-first" name="first_name" data-name="first_name" autocomplete="given-name" /></div>
        <div class="field"><label for="f-last">Last name</label><input id="f-last" name="last_name" data-name="last_name" autocomplete="family-name" /></div>
      </div>
      <div class="field"><label for="f-email">Email</label><input id="f-email" name="email" data-name="email" type="email" autocomplete="email" /></div>
      <div class="field"><label for="f-phone">Mobile number</label><input id="f-phone" name="phone" data-name="phone" type="tel" autocomplete="tel" inputmode="tel" /></div>
      <button class="btn btn-primary btn-big sf-wide js-details" type="button" data-for="speak">Submit your details</button>
      <button class="btn btn-primary btn-big sf-wide js-details" type="button" data-for="info" hidden>Next</button>
      <p class="sf-err" role="alert" hidden></p>
      <p class="sf-legal">By sending this you agree to Blueprint Fitness contacting you by phone, text and email about the {offer}.</p>
    </fieldset>

    <fieldset data-step="prefer" hidden>
      <legend>How would you like us to get in touch?</legend>
      <div class="sf-opts">
        <label class="sf-opt"><input type="radio" data-name="prefer" value={PATH.message} /><span>Send me a message</span></label>
        <label class="sf-opt"><input type="radio" data-name="prefer" value={PATH.call} /><span>Give me a call</span></label>
      </div>
    </fieldset>

    <section data-step="call" hidden>
      <h3>Thanks, <span data-first></span>! Now pick a time for a free call with one of our coaches.</h3>
      <p class="sf-sub">It&rsquo;s a relaxed chat where your coach hears where you&rsquo;re at and answers any questions you have.</p>
      <p class="book__wait sf-sub">Finding our coaches&rsquo; free times&hellip;</p>
      <div class="book__days" role="group" aria-label="Day" hidden></div>
      <div class="book__times" role="group" aria-label="Time" hidden></div>
      <div class="book__confirm" hidden>
        <p class="book__pick"><span>Your call</span><b></b></p>
        <button type="button" class="btn btn-primary btn-big sf-wide book__go">Confirm my call &rarr;</button>
      </div>
      <p class="sf-err book__err" role="alert" hidden></p>
      <p class="book__none sf-sub" hidden>We couldn&rsquo;t load the diary just now, but we&rsquo;ve got your details and we&rsquo;ll be in touch to find a time.</p>
      <a class="sf-skip" href="#">Skip this for now and we&rsquo;ll be in touch</a>
    </section>

    <section data-step="done" class="sf-done" hidden>
      <h3>You&rsquo;re all set, <span data-first></span>.</h3>
      <p data-if="booked">Your call with one of our coaches is booked for <b data-when></b>, and we&rsquo;ll text you a reminder beforehand.</p>
      <p data-if="later" hidden>We&rsquo;ll be in touch very soon by text, so keep an eye on your phone.</p>
      <p data-if="call" hidden>We&rsquo;ll give you a ring very soon, so keep an eye on your phone.</p>
      <p data-if="message" hidden>We&rsquo;ll send you a message very soon, and you can ask us anything there.</p>
      <p data-if-not="message">We sit down with everyone before their first session, so your coach knows you and your plan before you start.</p>
      <button class="btn btn-ghost sf-wide js-close" type="button">Close</button>
    </section>

    <p class="sf-off" aria-hidden="true">
      {questions.map((q) => <input type="text" name={q.field} tabindex="-1" autocomplete="off" />)}
      <input type="text" name="enquiry_path" tabindex="-1" autocomplete="off" />
      <input type="text" name="enquiry_ad" value="Main website" tabindex="-1" autocomplete="off" readonly />
    </p>
  </form>
</main>

<style is:global>
  .sf-body{margin:0;background:
    linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px),var(--draft);
    background-size:32px 32px,32px 32px,auto;color:#fff;font-family:var(--font-body)}
  .sf{max-width:30rem;margin:0 auto;padding:1.1rem 1.25rem 1.5rem}
  .sf-head{display:flex;align-items:center;gap:.75rem;min-height:2.2rem;margin:0 0 .9rem;padding-right:2.6rem}
  .sf-back{background:none;border:0;color:var(--sky);font:600 .9rem var(--font-body);cursor:pointer;padding:.3rem 0}
  .sf-bar{flex:1;height:4px;border-radius:4px;background:rgba(255,255,255,.12);overflow:hidden}
  .sf-bar i{display:block;height:100%;background:var(--blue);transform-origin:left;transform:scaleX(0);transition:transform .35s var(--ease-out)}
  .sf-count{color:#9fb6d8;font-size:.8rem;white-space:nowrap}
  .sf-form fieldset{border:0;margin:0;padding:0;min-width:0}
  .sf-form legend,.sf-form h3{font-family:var(--font-display);font-weight:800;font-size:clamp(1.25rem,4.6vw,1.55rem);line-height:1.2;margin:0 0 1rem;padding:0;color:#fff}
  .sf-form legend:focus,.sf-form h3:focus{outline:none}
  .sf-opts{display:grid;gap:.6rem}
  .sf-opt{position:relative;display:block;cursor:pointer}
  .sf-opt input{position:absolute;inset:0;opacity:0;margin:0;cursor:pointer}
  .sf-opt span{display:block;padding:.95rem 1.1rem;border:1px solid rgba(94,162,255,.35);border-radius:10px;background:rgba(255,255,255,.04);
    font-weight:600;color:#EAF1FB;transition:background .15s,border-color .15s}
  .sf-opt input:checked+span{background:var(--blue);border-color:var(--blue);color:#fff}
  .sf-opt input:focus-visible+span{outline:2px solid var(--sky);outline-offset:2px}
  @media (hover:hover){.sf-opt:hover span{border-color:var(--sky);background:rgba(94,162,255,.1)}}
  .sf-sub{color:#cfdcf0;font-size:.95rem;line-height:1.55;margin:-.3rem 0 1.1rem}
  .sf-two{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}
  .sf-form .field{margin:0 0 .85rem}
  .sf-form .field label{display:block;font-size:.85rem;font-weight:600;color:#EAF1FB;margin:0 0 .35rem}
  .sf-form .field input{width:100%;box-sizing:border-box;padding:.8rem .9rem;border-radius:8px;border:1px solid rgba(94,162,255,.35);
    background:#fff;color:var(--ink);font:500 1rem var(--font-body)}
  .sf-form .field input[aria-invalid="true"]{border-color:#FF9B9B;box-shadow:0 0 0 2px rgba(255,155,155,.35)}
  .sf-wide{width:100%;justify-content:center;margin-top:.4rem}
  .sf-err{color:#FF9B9B;font-size:.9rem;margin:.7rem 0 0}
  .sf-legal{color:#9fb6d8;font-size:.75rem;line-height:1.5;margin:.9rem 0 0}
  .sf-skip{display:block;text-align:center;color:var(--sky);font-size:.9rem;margin:1.1rem 0 0}
  .sf-done p{color:#EAF1FB;line-height:1.6}
  .sf-off{position:absolute;left:-9999px;top:0;width:1px;height:1px;overflow:hidden;margin:0}
  .book__days{display:flex;gap:.5rem;overflow-x:auto;padding:0 0 .5rem;margin:0 0 .75rem}
  .book__day{flex:0 0 auto;min-width:4.4rem;padding:.55rem .6rem;border-radius:10px;border:1px solid rgba(94,162,255,.35);background:rgba(255,255,255,.04);
    color:#EAF1FB;font:700 .9rem var(--font-body);cursor:pointer;text-align:center}
  .book__day small{display:block;font-weight:500;font-size:.75rem;color:#9fb6d8}
  .book__day[aria-pressed="true"]{background:var(--blue);border-color:var(--blue);color:#fff}
  .book__day[aria-pressed="true"] small{color:#EAF1FB}
  .book__times{display:grid;grid-template-columns:repeat(auto-fill,minmax(5.5rem,1fr));gap:.5rem}
  .book__time{min-height:46px;border-radius:10px;border:1px solid rgba(94,162,255,.35);background:rgba(255,255,255,.04);color:#fff;font:600 .95rem var(--font-body);cursor:pointer}
  .book__time[aria-pressed="true"]{background:var(--blue);border-color:var(--blue)}
  .book__time:disabled{opacity:.35;text-decoration:line-through}
  .book__confirm{position:sticky;bottom:0;margin:1rem 0 0;padding:.75rem 0 calc(.75rem + env(safe-area-inset-bottom));background:var(--draft)}
  .book__pick{display:flex;flex-direction:column;gap:2px;margin:0 0 .6rem;padding:.75rem .9rem;border-radius:12px;border:1px solid rgba(94,162,255,.35);background:rgba(94,162,255,.08)}
  .book__pick span{font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#9fb6d8}
  .book__pick b{font-size:1.05rem}
  .book__go:disabled{opacity:.75;cursor:progress}
  [hidden]{display:none!important}
  @media (max-width:380px){.sf-two{grid-template-columns:1fr}}
  @media (prefers-reduced-motion:reduce){.sf-bar i{transition:none}}
</style>

<script is:inline define:vars={{ formId: form, SPEAK: PATH.speak }}>
(function () {
  'use strict';
  var form = document.getElementById(formId);
  var studio = form.getAttribute('data-studio');
  var hasCal = !!form.getAttribute('data-cal');
  var path = new URLSearchParams(location.search).get('path') === 'info' ? 'info' : 'speak';
  var steps = [].slice.call(form.querySelectorAll('[data-step]'));
  var quiz = steps.filter(function (s) { return s.hasAttribute('data-q'); });
  var bar = document.querySelector('.sf-bar i'), back = document.querySelector('.sf-back'), count = document.querySelector('.sf-count');
  var at = 0, captured = false, first = '', lead = {}, leadReq = null;

  // The details step says what happens next for the way they came in.
  form.querySelectorAll('[data-for]').forEach(function (el) { el.hidden = el.getAttribute('data-for') !== path; });

  // Tell the pop-up how tall this is, so the frame fits without its own scrollbar.
  function tell(msg) { try { if (parent !== window) parent.postMessage(Object.assign({ bp: 'start' }, msg), location.origin); } catch (e) { /* fine */ } }
  // The page's own height, not the document's: the document is never shorter than the frame, so it would never shrink.
  var main = document.querySelector('.sf');
  function height() { return Math.ceil(main.getBoundingClientRect().height); }
  function size() { tell({ h: height() }); }
  addEventListener('resize', size);

  function step(name) { return form.querySelector('[data-step="' + name + '"]'); }
  function show(i) {
    at = Math.max(0, Math.min(i, steps.length - 1));
    steps.forEach(function (s, k) { s.hidden = k !== at; });
    var n = quiz.length, q = quiz.indexOf(steps[at]);
    var total = n + 2, done = q !== -1 ? q : steps[at].getAttribute('data-step') === 'details' ? n : n + 1;
    if (steps[at].getAttribute('data-step') === 'done') done = total;
    bar.style.transform = 'scaleX(' + Math.min(1, done / total) + ')';
    count.textContent = q === -1 ? '' : (q + 1) + ' of ' + n;
    back.hidden = at === 0 || captured;
    var h = steps[at].querySelector('legend, h3');
    if (h) { h.setAttribute('tabindex', '-1'); h.focus({ preventScroll: true }); }
    scrollTo(0, 0);
    requestAnimationFrame(function () { tell({ h: height(), top: true }); });
  }
  back.addEventListener('click', function () {
    var cur = steps[at].getAttribute('data-step');
    show(cur === 'prefer' ? steps.indexOf(step('details')) : at - 1);
  });

  function picked(s) { return s.querySelector('input[type=radio]:checked'); }
  function set(name, v) { var el = form.querySelector('.sf-off [name="' + name + '"]'); if (el) el.value = v; }

  // A tap is an answer: ticked for a beat, then the next step (once, and only if that step is still showing).
  var moving = null;
  function answered(e) {
    var t = e.target;
    if (!t || t.type !== 'radio' || !t.checked) return;
    var s = t.closest('[data-step]');
    if (!s || steps[at] !== s || moving === s) return;
    moving = s;
    setTimeout(function () {
      moving = null;
      if (steps[at] !== s) return;
      if (s.getAttribute('data-step') === 'prefer') { set('enquiry_path', t.value); capture(); return; }
      show(steps.indexOf(s) + 1);
    }, 220);
  }
  form.addEventListener('click', answered);
  form.addEventListener('change', answered);

  // ------------------------------------------------------------------ the details
  var DETAILS = ['first_name', 'last_name', 'email', 'phone'];
  function field(n) { return form.querySelector('[data-name="' + n + '"]'); }
  function valid(n) {
    var el = field(n), v = el.value.trim(), ok = !!v;
    if (n === 'email') ok = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v);
    if (n === 'phone') ok = v.replace(/[^\d]/g, '').length >= 10;
    el.setAttribute('aria-invalid', ok ? 'false' : 'true');
    return ok;
  }
  form.querySelectorAll('.js-details').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var err = step('details').querySelector('.sf-err');
      var missing = quiz.filter(function (s) { return !picked(s); })[0];
      if (missing) { show(steps.indexOf(missing)); return; }
      var bad = DETAILS.filter(function (n) { return !valid(n); });
      if (bad.length) {
        err.textContent = bad[0] === 'email' ? 'Please check your email address.' : bad[0] === 'phone' ? 'Please check your mobile number.' : 'Please fill in your name.';
        err.hidden = false; field(bad[0]).focus(); size(); return;
      }
      err.hidden = true;
      if (path === 'info') { show(steps.indexOf(step('prefer'))); return; }
      set('enquiry_path', SPEAK);
      capture();
    });
  });

  // Sent: External Tracking reads the form as website-<studio> on submit. Then the call step, or done.
  function capture() {
    if (captured) return;
    quiz.forEach(function (s) { set(s.getAttribute('data-field'), picked(s).value); });
    first = field('first_name').value.trim();
    form.querySelectorAll('[data-first]').forEach(function (el) { el.textContent = first; });
    captured = true;
    if (form.requestSubmit) form.requestSubmit(); else form.dispatchEvent(new Event('submit', { cancelable: true }));
    track('website_lead', { studio: studio, path: form.querySelector('.sf-off [name="enquiry_path"]').value });
    var chose = form.querySelector('.sf-off [name="enquiry_path"]').value;
    if (path === 'speak' && hasCal) {
      var data = { studio: studio };
      DETAILS.forEach(function (n) { data[n] = field(n).value.trim(); });
      leadReq = fetch('/api/lead', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
        .then(function (r) { return r.ok ? r.json() : {}; }).catch(function () { return {}; });
      setTimeout(call, 400);   // the tracker sends first
      return;
    }
    // speak, at a studio with no call calendar: the coach rings
    setTimeout(function () { finish(/message/i.test(chose) ? 'message' : 'call'); }, 400);
  }
  form.addEventListener('submit', function (e) { e.preventDefault(); });

  // ------------------------------------------------------------------ a time for the call
  function call() {
    var st = step('call');
    show(steps.indexOf(st));
    var days = st.querySelector('.book__days'), times = st.querySelector('.book__times'), wait = st.querySelector('.book__wait');
    Promise.all([leadReq, fetch('/api/slots?studio=' + encodeURIComponent(studio)).then(function (r) { return r.ok ? r.json() : null; }).catch(function () { return null; })])
      .then(function (r) {
        lead = r[0] || {};
        wait.hidden = true;
        if (!r[1] || !r[1].days || !r[1].days.length || !lead.id) { st.querySelector('.book__none').hidden = false; size(); return; }
        picker(r[1], days, times);
      });
  }
  function fmtDay(d) { return new Date(d + 'T12:00:00').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' }); }
  function fmtTime(s, tz) { return new Date(s).toLocaleTimeString('en-GB', { hour: 'numeric', minute: '2-digit', timeZone: tz }); }
  var pick = null;
  function picker(r, days, times) {
    days.innerHTML = ''; days.hidden = false;
    r.days.slice(0, 7).forEach(function (d, i) {
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'book__day'; b.setAttribute('aria-pressed', i === 0 ? 'true' : 'false');
      var p = fmtDay(d.date).split(' ');
      b.innerHTML = p[0].replace(',', '') + '<small>' + p.slice(1).join(' ') + '</small>';
      b.addEventListener('click', function () {
        days.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
        list(d);
      });
      days.appendChild(b);
    });
    function list(d) {
      times.innerHTML = ''; times.hidden = false; unpick();
      d.slots.forEach(function (s) {
        var b = document.createElement('button');
        b.type = 'button'; b.className = 'book__time'; b.textContent = fmtTime(s, r.tz);
        b.addEventListener('click', function () { choose(s, b, r.tz); });
        times.appendChild(b);
      });
      size();
    }
    list(r.days[0]);
  }
  // A tapped time is confirmed before it books (client-sites/_shared/confirm-call).
  var confirmBar = step('call').querySelector('.book__confirm');
  function unpick() { if (pick) pick.btn.setAttribute('aria-pressed', 'false'); pick = null; confirmBar.hidden = true; }
  function choose(start, btn, tz) {
    if (pick) pick.btn.setAttribute('aria-pressed', 'false');
    btn.setAttribute('aria-pressed', 'true');
    pick = { start: start, btn: btn };
    confirmBar.querySelector('b').textContent = new Date(start).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', timeZone: tz }) + ' at ' + fmtTime(start, tz);
    step('call').querySelector('.book__err').hidden = true;
    confirmBar.hidden = false; size();
    try { confirmBar.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); } catch (e) { /* fine */ }
  }
  confirmBar.querySelector('.book__go').addEventListener('click', function () {
    if (!pick) return;
    var go = this, label = go.innerHTML, err = step('call').querySelector('.book__err'), slot = pick.btn, start = pick.start;
    go.disabled = true; go.textContent = 'Booking your call…'; err.hidden = true;
    fetch('/api/book', { method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: lead.id, token: lead.token, start: start, type: 'call', studio: studio }) })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, status: r.status, j: j }; }); })
      .then(function (r) {
        if (!r.ok) throw r;
        track('website_booked', { studio: studio });
        finish('booked', new Date(start).toLocaleString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', hour: 'numeric', minute: '2-digit', timeZone: 'Europe/London' }));
      }).catch(function (r) {
        go.disabled = false; go.innerHTML = label;
        if (r && r.status === 409) { slot.disabled = true; unpick(); }
        err.textContent = r && r.status === 409 ? 'Someone has just taken that time. Pick another?' : 'That didn’t go through. Try another time, or skip and we’ll be in touch.';
        err.hidden = false; size();
      });
  });
  step('call').querySelector('.sf-skip').addEventListener('click', function (e) { e.preventDefault(); finish('later'); });

  // ------------------------------------------------------------------ done
  function finish(kind, when) {
    var done = step('done');
    done.querySelectorAll('[data-if]').forEach(function (el) { el.hidden = el.getAttribute('data-if') !== kind; });
    done.querySelectorAll('[data-if-not]').forEach(function (el) { el.hidden = el.getAttribute('data-if-not') === kind; });
    var w = done.querySelector('[data-when]'); if (w) w.textContent = when || '';
    show(steps.indexOf(done));
    tell({ done: kind });
  }
  form.querySelector('.js-close').addEventListener('click', function () {
    if (parent !== window) tell({ close: true }); else location.href = '/';
  });

  function track(name, extra) { try { (window.dataLayer = window.dataLayer || []).push(Object.assign({ event: name }, extra || {})); } catch (e) { /* fine */ } }

  show(0);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(size);
})();
</script>
<!-- This studio's GHL External Tracking only: it sends the form above as website-{studio.slug} to this studio's GHL. -->
<Fragment set:html={studio.trackingScript} />
</body>
</html>
