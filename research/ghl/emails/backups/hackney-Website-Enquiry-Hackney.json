    {
     "id": "6132a5e2-2e9a-4a0e-a04a-f511b61f2486",
     "type": "email",
     "name": "Confirmation email",
     "attributes": {
      "from_name": "Blueprint Fitness Hackney",
      "from_email": "hackney@blueprintfitnessldn.com",
      "subject": "Hello {{contact.first_name}} — quick question about your 30 Day Kickstart",
      "html": "<!doctype html>\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"x-apple-disable-message-reformatting\">\n<title>Your 30-Day Kickstart at Blueprint Fitness Hackney</title>\n</head>\n<body style=\"margin:0;padding:0;background:#EAF1FB;-webkit-font-smoothing:antialiased\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Thanks for registering your interest — one quick question before we book you in.</div>\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#EAF1FB\">\n <tr><td align=\"center\" style=\"padding:28px 0\">\n\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;background:#ffffff;border-radius:14px;overflow:hidden\">\n\n   <!-- header: ink with the blueprint grid -->\n   <tr><td style=\"background:#101B2F;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:32px 32px;padding:26px 32px\">\n     <img src=\"https://blueprintfitnessldn.com/img/logo-horizontal-blue.png\" width=\"200\" alt=\"Blueprint Fitness\"\n          style=\"display:block;border:0;outline:none;text-decoration:none;width:200px;max-width:200px;height:auto\">\n   </td></tr>\n\n   <!-- headline -->\n   <tr><td style=\"padding:34px 32px 0\">\n     <p style=\"margin:0 0 10px;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#0072F5\">The 30-Day Kickstart &middot; Hackney</p>\n     <h1 style=\"margin:0 0 18px;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:30px;line-height:1.15;font-weight:800;color:#101B2F\">Hello {{contact.first_name}}, you&rsquo;re on the list.</h1>\n     <p style=\"margin:0 0 16px;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:16px;line-height:1.65;color:#3D4A63\">Thanks for registering your interest in our 30&nbsp;Day Kickstart at <strong style=\"color:#101B2F\">Blueprint Fitness Hackney</strong>. A coach will give you a ring shortly for a friendly chat &mdash; no hard sell, ever.</p>\n   </td></tr>\n\n   <!-- the one question -->\n   <tr><td style=\"padding:6px 32px 0\">\n     <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#EAF1FB;border-left:4px solid #0072F5;border-radius:0 10px 10px 0\">\n      <tr><td style=\"padding:18px 20px\">\n        <p style=\"margin:0;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;font-weight:700;color:#101B2F\">Just to check &mdash; are you local to Hackney?</p>\n        <p style=\"margin:8px 0 0;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;color:#3D4A63\">Reply to this email or message us on WhatsApp and we&rsquo;ll get your first session booked in.</p>\n      </td></tr>\n     </table>\n   </td></tr>\n\n   <!-- what the 30 days include -->\n   <tr><td style=\"padding:28px 32px 0\">\n     <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n      <tr>\n       <td width=\"32%\" align=\"center\" style=\"padding:14px 6px;background:#F5F9FF;border-radius:10px\">\n         <p style=\"margin:0;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:24px;font-weight:800;color:#0072F5\">12</p>\n         <p style=\"margin:2px 0 0;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:#3D4A63\">Coached sessions</p>\n       </td>\n       <td width=\"2%\">&nbsp;</td>\n       <td width=\"32%\" align=\"center\" style=\"padding:14px 6px;background:#F5F9FF;border-radius:10px\">\n         <p style=\"margin:0;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:24px;font-weight:800;color:#0072F5\">5:1</p>\n         <p style=\"margin:2px 0 0;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:#3D4A63\">Max ratio</p>\n       </td>\n       <td width=\"2%\">&nbsp;</td>\n       <td width=\"32%\" align=\"center\" style=\"padding:14px 6px;background:#F5F9FF;border-radius:10px\">\n         <p style=\"margin:0;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:24px;font-weight:800;color:#0072F5\">100+</p>\n         <p style=\"margin:2px 0 0;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:#3D4A63\">Sessions a week</p>\n       </td>\n      </tr>\n     </table>\n   </td></tr>\n\n   <!-- CTAs: table-cell buttons so Outlook renders them -->\n   <tr><td style=\"padding:26px 32px 0\">\n     <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\">\n      <tr><td align=\"center\" style=\"background:#0072F5;border-radius:9px\">\n        <a href=\"https://blueprintfitnessldn.com/signup-hackney/\" style=\"display:block;padding:15px 24px;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:16px;font-weight:700;color:#ffffff;text-decoration:none\">Start your 30 days &rarr;</a>\n      </td></tr>\n      <tr><td height=\"10\" style=\"height:10px;line-height:10px\">&nbsp;</td></tr>\n      <tr><td align=\"center\" style=\"border:1.5px solid #0072F5;border-radius:9px\">\n        <a href=\"https://wa.me/447944690356?text=Hi%20Blueprint%20Fitness%20Hackney%20%E2%80%94%20I've%20just%20registered%20my%20interest%20in%20the%2030%20Day%20Kickstart.\" style=\"display:block;padding:13px 24px;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;font-weight:700;color:#0072F5;text-decoration:none\">Message Hackney on WhatsApp</a>\n      </td></tr>\n     </table>\n   </td></tr>\n\n   <!-- sign-off -->\n   <tr><td style=\"padding:28px 32px 0\">\n     <p style=\"margin:0 0 3px;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#3D4A63\">Speak soon,</p>\n     <p style=\"margin:0;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:16px;font-weight:800;color:#101B2F\">Nick</p>\n     <p style=\"margin:2px 0 0;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#3D4A63\">Blueprint Fitness Hackney</p>\n   </td></tr>\n\n   <tr><td style=\"padding:26px 32px 0\"><div style=\"height:1px;background:#EAF1FB;line-height:1px\">&nbsp;</div></td></tr>\n\n   <!-- studio details -->\n   <tr><td style=\"padding:20px 32px 32px\">\n     <p style=\"margin:0 0 6px;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#0072F5\">Your studio</p>\n     <p style=\"margin:0 0 3px;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;font-weight:700;color:#101B2F\">Blueprint Fitness Hackney</p>\n     <p style=\"margin:0 0 3px;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6;color:#3D4A63\">Arch 195, Morning Lane, Hackney Central, London, E9 6LJ</p>\n     <p style=\"margin:0 0 3px;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6;color:#3D4A63\">Mon–Fri 6am–9pm · Sat–Sun 8am–4pm</p>\n     <p style=\"margin:0;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6\"><a href=\"mailto:hackney@blueprintfitnessldn.com\" style=\"color:#0072F5;text-decoration:none\">hackney@blueprintfitnessldn.com</a></p>\n   </td></tr>\n\n  </table>\n\n  <p style=\"margin:16px auto 0;max-width:600px;font-family:Inter,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#3D4A63;text-align:center\">\n    You&rsquo;re getting this because you registered your interest at\n    <a href=\"https://blueprintfitnessldn.com\" style=\"color:#0072F5;text-decoration:none\">blueprintfitnessldn.com</a>.\n  </p>\n\n </td></tr>\n</table>\n</body></html>",
