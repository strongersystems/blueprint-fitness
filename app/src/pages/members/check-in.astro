---
import Base from "../../layouts/Base.astro";
import MembersNav from "../../components/MembersNav.astro";
import { url } from "../../lib/url";
import { studios } from "../../data/studios";
---
<Base
  title={'Member check-in — Blueprint Fitness'}
  description={'Submit a check-in to your Blueprint Fitness coach.'}
  noindex
  trackAll>

  <MembersNav current="check-in" />


  <section class="section on-dark section-tight">
    <div class="container">
      <p class="dim sec-head" style="margin-bottom:1rem">Member check-in</p>
      <h1 class="h-display">How are you <span class="draft-u">getting on?</span></h1>
      <p class="lede">Whether training&rsquo;s flying or something&rsquo;s in the way, tell us. A coach reads every check-in and comes back to you personally.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2" style="align-items:start">
      <div>
        <p class="annotation reveal">No question too small</p>
        <h2 class="h-1">What happens next</h2>
        <p class="lede">Your check-in goes straight to the coaching team. We&rsquo;ll read it
          properly &mdash; not skim it &mdash; and get back to you with an answer, a tweak to
          your plan, or a chat at your next session.</p>
        <ul class="check-list" style="margin-top:1.3rem">
          <li>Struggling with a lift, a habit, or motivation &mdash; say so</li>
          <li>Niggles and injuries &mdash; the earlier we know, the better</li>
          <li>Goals changed? We&rsquo;ll redraw the plan around them</li>
        </ul>
        <p class="annotation reveal" style="margin-top:1rem">Honest check-ins make the best coaching. We&rsquo;d rather know.</p>
      </div>
      <div class="card" style="align-self:start">
        <form id="members-check-in-all-sites" name="members-check-in-all-sites" data-placeholder-form data-success="#checkin-success" novalidate>
          <div class="field">
            <label for="ci-name">First name</label>
            <input id="ci-name" name="first_name" type="text" autocomplete="given-name" required>
            <p class="err">Please tell us your name.</p>
          </div>
          <div class="field">
            <label for="ci-email">Email</label>
            <input id="ci-email" name="email" type="email" autocomplete="email" required>
            <p class="err">That email doesn&rsquo;t look right.</p>
          </div>
          <div class="field">
            <label for="ci-phone">Phone number</label>
            <input id="ci-phone" name="phone" type="tel" autocomplete="tel" required>
            <p class="err">Please add a number so a coach can call you back.</p>
          </div>
          <div class="field">
            <label for="ci-location">Which studio?</label>
            <select id="ci-location" name="location" required>
              <option value="">Choose a studio&hellip;</option>
              {studios.map((st) => (<option value={st.formValue}>{st.name}</option>))}
            </select>
            <p class="err">Pick the studio you train at.</p>
          </div>
          <div class="field">
            <label for="ci-msg">What can we help you with?</label>
            <textarea id="ci-msg" name="message" rows="6" required></textarea>
            <p class="err">Tell us a little about what&rsquo;s going on &mdash; a sentence is plenty.</p>
          </div>
          <div class="field">
            <label class="check-field"><input type="checkbox" name="confirm" required>
              <span>I confirm the details above are correct.</span></label>
            <p class="err">Please tick to confirm your details are correct.</p>
          </div>
          <button class="btn btn-primary btn-big" type="submit" style="width:100%">Send my check-in</button>
        </form>
        <div class="form-success" id="checkin-success" role="status">
          <span class="stamp">Check-in received</span>
          <h3 class="h-2" style="margin-top:1.2rem">Thanks &mdash; we&rsquo;re on it.</h3>
          <p style="color:var(--grey)">A coach will come back to you personally, usually within a working day.</p>
        </div>
      </div>
    </div>
  </section>


</Base>
