---
import Base from "../layouts/Base.astro";
import { url } from "../lib/url";
import { studios } from "../data/studios";
---
<Base
  title={'Page not found — Blueprint Fitness'}
  description={"Sorry, we can't find that page."}
  noindex>

  <section class="section on-dark">
    <div class="container">
      <p class="dim sec-head" style="margin-bottom:1rem">Error 404</p>
      <h1 class="h-display">Not on the <span class="draft-u">plan.</span></h1>
      <p class="lede">Sorry, we can&rsquo;t find that page. It&rsquo;s probably moved since we
        rebuilt the site.</p>
      <p style="margin-top:1.8rem">
        <a class="btn btn-primary btn-big" href={url("")}>Back to the home page</a>
      </p>
      <ul class="check-list" style="margin-top:1.8rem">
        <li><a href={url("kickstart/")} style="color:#5EA2FF">The 30-Day Kickstart</a>, to come and try us</li>
        <li><a href={url("locations/")} style="color:#5EA2FF">Our studios</a> in {studios.slice(0, -1).map((s) => s.name).join(', ')} and {studios[studios.length - 1].name}</li>
        <li><a href={url("contact/")} style="color:#5EA2FF">Contact</a>, to message the team</li>
        <li><a href={url("members/")} style="color:#5EA2FF">Members area</a>, for check-ins, bookings and cancellations</li>
      </ul>
    </div>
  </section>
</Base>
