---
/**
 * Password gate for a static page.
 *
 * The site is static, so there is no server to check a password against. A gate
 * that merely hides markup would be no gate at all — the content sits in view
 * source. So the slot is rendered to HTML at BUILD time, encrypted with
 * AES-GCM under a PBKDF2 key derived from the password, and only the
 * ciphertext ships. Without the password the page genuinely contains nothing
 * but random bytes.
 *
 * This is real encryption, but the threat model is modest: the password is
 * shared and unchanging, so treat it as "keep this off the open web", not as
 * access control. For proper auth, Cloudflare Access sits in front of the whole
 * route for free — the domain is already proxied through Cloudflare.
 */
import { webcrypto as crypto } from 'node:crypto';

interface Props { password: string; label?: string }
const { password, label = 'This page is protected.' } = Astro.props;

const html = await Astro.slots.render('default');

const enc = new TextEncoder();
const salt = crypto.getRandomValues(new Uint8Array(16));
const iv = crypto.getRandomValues(new Uint8Array(12));
const base = await crypto.subtle.importKey('raw', enc.encode(password), 'PBKDF2', false, ['deriveKey']);
const key = await crypto.subtle.deriveKey(
  { name: 'PBKDF2', salt, iterations: 250_000, hash: 'SHA-256' },
  base, { name: 'AES-GCM', length: 256 }, false, ['encrypt']);
const cipher = new Uint8Array(await crypto.subtle.encrypt({ name: 'AES-GCM', iv }, key, enc.encode(html)));
const b64 = (u: Uint8Array) => Buffer.from(u).toString('base64');
---

<div id="gate" class="gate">
  <div class="gate-card">
    <p class="dim" style="margin:0 0 .4rem">Internal</p>
    <h1 class="h-2" style="margin:0 0 .6rem">Blueprint Fitness</h1>
    <p style="margin:0 0 1.2rem;color:var(--grey)">{label}</p>
    <form id="gate-form" novalidate>
      <div class="field">
        <label for="gate-pw">Password</label>
        <input id="gate-pw" name="password" type="password" autocomplete="current-password" autofocus />
        <p class="err" id="gate-err">That password is not right.</p>
      </div>
      <button class="btn btn-primary" type="submit" style="width:100%">Unlock</button>
    </form>
    <noscript><p class="small" style="margin-top:1rem;color:var(--grey)">This page needs JavaScript to unlock.</p></noscript>
  </div>
</div>

<div id="gated" hidden></div>

<script define:vars={{ ct: b64(cipher), salt: b64(salt), iv: b64(iv) }} is:inline>
  (function () {
    var KEY = 'bf-admin-unlocked';
    var bytes = function (b64) { return Uint8Array.from(atob(b64), function (c) { return c.charCodeAt(0); }); };

    async function unlock(pw) {
      var enc = new TextEncoder();
      var base = await crypto.subtle.importKey('raw', enc.encode(pw), 'PBKDF2', false, ['deriveKey']);
      var key = await crypto.subtle.deriveKey(
        { name: 'PBKDF2', salt: bytes(salt), iterations: 250000, hash: 'SHA-256' },
        base, { name: 'AES-GCM', length: 256 }, false, ['decrypt']);
      /* a wrong password fails the GCM auth tag and throws — that IS the check */
      var out = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: bytes(iv) }, key, bytes(ct));
      return new TextDecoder().decode(out);
    }

    function reveal(html) {
      var g = document.getElementById('gated');
      g.innerHTML = html;
      g.hidden = false;
      document.getElementById('gate').remove();
      /* re-run any inline scripts the revealed markup carried */
      g.querySelectorAll('script').forEach(function (old) {
        var s = document.createElement('script');
        if (old.src) s.src = old.src; else s.textContent = old.textContent;
        old.replaceWith(s);
      });
    }

    var form = document.getElementById('gate-form');
    var err = document.getElementById('gate-err');
    var field = document.getElementById('gate-pw').closest('.field');

    /* stay unlocked for the tab, so links back to the page do not re-prompt */
    try {
      var saved = sessionStorage.getItem(KEY);
      if (saved) unlock(saved).then(reveal).catch(function () { sessionStorage.removeItem(KEY); });
    } catch (e) {}

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var pw = document.getElementById('gate-pw').value;
      unlock(pw).then(function (html) {
        try { sessionStorage.setItem(KEY, pw); } catch (e) {}
        reveal(html);
      }).catch(function () {
        field.classList.add('invalid');
        err.textContent = 'That password is not right.';
      });
    });
  })();
</script>

<style is:global>
  .gate { min-height: 70vh; display: flex; align-items: center; justify-content: center; padding: 2rem 1rem; }
  .gate-card { width: min(24rem, 100%); background: #fff; border: 1px solid rgba(16,27,47,.12);
    border-radius: 14px; padding: clamp(1.4rem, 4vw, 2rem); box-shadow: 0 1px 3px rgba(16,27,47,.07); }
  .gate .err { display: none; }
  .gate .field.invalid .err { display: block; }
</style>
