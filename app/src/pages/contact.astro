---
import Base from "../layouts/Base.astro";
import { url } from "../lib/url";
---
<Base
  title={'Contact — Blueprint Fitness'}
  description={'Get in touch with Blueprint Fitness — Hackney, South Woodford and Leytonstone.'}
  current="Contact"
  trackAll>


  <section class="section on-dark section-tight">
    <div class="container">
      <p class="dim sec-head" style="margin-bottom:1rem">We&rsquo;d love to hear from you</p>
      <h1 class="h-display">Get in <span class="draft-u">touch</span></h1>
      <p class="lede">Have a question about our programmes or want to tour a facility? Pick your
        location below and reach out.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-3 stagger" style="margin-bottom:3rem">
        <article class="card">
          <p class="annotation" style="margin:0">South Woodford</p>
          <h2 class="h-3">4 Raven Road</h2>
          <p>South Woodford, London E18 1HB<br>
             Sessions 6am&ndash;9pm daily<br>
             <a href="mailto:southwoodford@blueprintfitnessldn.com">southwoodford@blueprintfitnessldn.com</a></p>
        </article>
        <article class="card">
          <p class="annotation" style="margin:0">Leytonstone</p>
          <h2 class="h-3">Unit 3, Hitchcock Business Centre</h2>
          <p>Leytonstone High Road, London E11 4RE<br>
             Early, daytime, evening &amp; weekends<br>
             <a href="mailto:leytonstone@blueprintfitnessldn.com">leytonstone@blueprintfitnessldn.com</a></p>
        </article>
        <article class="card">
          <p class="annotation" style="margin:0">Hackney</p>
          <h2 class="h-3">Arch 195, Morning Lane</h2>
          <p>Hackney Central, London E9 6LJ<br>
             Mon&ndash;Fri 6am&ndash;9pm &middot; Sat&ndash;Sun 8am&ndash;4pm<br>
             <a href="mailto:hackney@blueprintfitnessldn.com">hackney@blueprintfitnessldn.com</a></p>
        </article>
      </div>

      <div class="grid-2" style="align-items:start">
        <div>
          <div class="sec-head" style="margin-bottom:1.2rem">
            <p class="dim">Send us a message</p>
            <h2 class="h-1">Ask us <span class="draft-u hl">anything</span></h2>
          </div>
          <p class="lede">Not sure which programme fits? Wondering if you&rsquo;re &ldquo;fit
            enough&rdquo; to start? (You are.) Drop us a line and a coach &mdash; not a bot &mdash;
            will get back to you.</p>
          <p class="annotation">We usually reply within one working day.</p>
          <div class="plan-frame reveal" style="aspect-ratio:4/3;max-width:26rem;margin-top:1.4rem">
            <img src={url("img/bf-chat.jpg")} alt="A Blueprint coach and member having a chat by the racks" loading="lazy" width="1200" height="1800" style="object-position:center 25%">
          </div>
        </div>
        <div style="background:var(--mist);border-radius:var(--radius);padding:clamp(1.4rem,4vw,2.2rem)">
          <span class="form-note">Placeholder form &mdash; nothing is sent yet</span>
          <form data-placeholder-form data-success="#contact-success" novalidate>
            <div class="field">
              <label for="c-name">Full name</label>
              <input id="c-name" name="name" type="text" autocomplete="name" required>
              <p class="err">Please tell us your name.</p>
            </div>
            <div class="field">
              <label for="c-email">Email address</label>
              <input id="c-email" name="email" type="email" autocomplete="email" required>
              <p class="err">That email doesn&rsquo;t look right.</p>
            </div>
            <div class="field">
              <label for="c-location">Location</label>
              <select id="c-location" name="location" required>
                <option value="">Choose a studio&hellip;</option>
                <option>South Woodford</option>
                <option>Leytonstone</option>
                <option>Hackney</option>
                <option>Not sure yet</option>
              </select>
              <p class="err">Pick a studio (or &ldquo;not sure yet&rdquo; is fine too).</p>
            </div>
            <div class="field">
              <label for="c-msg">Message</label>
              <textarea id="c-msg" name="message" rows="4" required></textarea>
              <p class="err">Tell us a little about what you&rsquo;re after.</p>
            </div>
            <button class="btn btn-primary" type="submit" style="width:100%">Send message</button>
          </form>
          <div class="form-success" id="contact-success" role="status">
            <span class="stamp">Message drafted</span>
            <h3 class="h-2" style="margin-top:1.2rem">Thanks &mdash; we&rsquo;ll be in touch.</h3>
            <p style="color:var(--grey)">A coach will reply within one working day.
              (Preview note: this form is a placeholder &mdash; nothing was actually sent.)</p>
          </div>
        </div>
      </div>
    </div>
  </section>


</Base>
