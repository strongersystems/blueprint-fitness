---
import Base from "../layouts/Base.astro";
import { url } from "../lib/url";
---
<Base
  title={'Locations — Blueprint Fitness | Hackney, South Woodford, Leytonstone'}
  description={'Find your nearest Blueprint Fitness studio: Hackney (Arch 195, Morning Lane), South Woodford (4 Raven Road) and Leytonstone (Hitchcock Business Centre).'}
  current="Locations"
  trackAll>


  <section class="section on-dark section-tight">
    <div class="container">
      <p class="dim sec-head" style="margin-bottom:1rem">Our London facilities</p>
      <h1 class="h-display">Choose your <span class="draft-u">location</span></h1>
      <p class="lede">Three studios, one way of doing things: small groups, proper coaching, and
        people who&rsquo;ll keep you coming back. Find the one closest to you.</p>
    </div>
  </section>

  <!-- SOUTH WOODFORD -->
  <section class="section " id="south-woodford">
    <div class="container grid-2" style="align-items:start">
      <span class="ghost-num" aria-hidden="true" style="top:.5rem;right:1rem">01</span>
      <div>
        <div class="plan-frame reveal" style="aspect-ratio:16/10">
          <img src={url("img/bf-sw-session.jpg")} alt="Mid-session on the South Woodford training floor" loading="lazy" width="1400" height="2100" style="object-position:center 45%">
        </div>
        <div class="map-frame reveal">
          <iframe src="https://maps.google.com/maps?q=4+Raven+Road,+South+Woodford,+London+E18+1HB&z=15&output=embed" loading="lazy"
                  title="Map — Blueprint Fitness South Woodford" referrerpolicy="no-referrer-when-downgrade"></iframe>
          <p class="map-cap"><span>E18 1HB</span>
            <a href="https://maps.google.com/maps?q=4+Raven+Road,+South+Woodford,+London+E18+1HB" rel="noopener" target="_blank">Open in Maps &rarr;</a></p>
        </div>
      </div>
      <div>
        <p class="annotation reveal">Where it all started</p>
        <h2 class="h-1">South Woodford</h2>
        <p class="lede">The original Blueprint. A premium training space with a thriving community, expert coaching, and structured group training focused on strength, conditioning and consistency.</p>
        <ul class="check-list">
          <li>4 Raven Road, South Woodford, London E18 1HB</li>
          <li>Open 6am&ndash;9pm, every day &mdash; 100+ sessions a week</li>
          <li>southwoodford@blueprintfitnessldn.com</li>
        </ul>
        <div class="btn-row">
          <a class="btn btn-primary" href={url("kickstart/")}>Try us for 30 days</a>
        </div>
      </div>
    </div>
  </section>

  <!-- LEYTONSTONE -->
  <section class="section on-mist" id="leytonstone">
    <div class="container grid-2" style="align-items:start">
      <span class="ghost-num" aria-hidden="true" style="top:.5rem;right:1rem">02</span>
      <div>
        <p class="annotation reveal">Progress you can measure</p>
        <h2 class="h-1">Leytonstone</h2>
        <p class="lede">Small group coaching built around measurable progress and long-term development &mdash; expertly designed programmes, delivered by coaches who genuinely care how you&rsquo;re getting on.</p>
        <ul class="check-list">
          <li>Unit 3, Hitchcock Business Centre, Leytonstone High Road, London E11 4RE</li>
          <li>Open early &rsquo;til late, 7 days a week</li>
          <li>leytonstone@blueprintfitnessldn.com</li>
        </ul>
        <div class="btn-row">
          <a class="btn btn-primary" href={url("kickstart/")}>Try us for 30 days</a>
        </div>
      </div>
      <div>
        <div class="plan-frame reveal" style="aspect-ratio:16/10">
          <img src={url("img/bf-bench-room.jpg")} alt="The training floor mid-session at Blueprint Fitness Leytonstone" loading="lazy" width="1400" height="2100" style="object-position:center 42%">
        </div>
        <div class="map-frame reveal">
          <iframe src="https://maps.google.com/maps?q=Hitchcock+Business+Centre,+Leytonstone+High+Road,+London+E11+4RE&z=15&output=embed" loading="lazy"
                  title="Map — Blueprint Fitness Leytonstone" referrerpolicy="no-referrer-when-downgrade"></iframe>
          <p class="map-cap"><span>E11 4RE</span>
            <a href="https://maps.google.com/maps?q=Hitchcock+Business+Centre,+Leytonstone+High+Road,+London+E11+4RE" rel="noopener" target="_blank">Open in Maps &rarr;</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- HACKNEY -->
  <section class="section " id="hackney">
    <div class="container grid-2" style="align-items:start">
      <span class="ghost-num" aria-hidden="true" style="top:.5rem;right:1rem">03</span>
      <div>
        <div class="plan-frame reveal" style="aspect-ratio:16/10">
          <video autoplay muted loop playsinline preload="metadata" width="1280" height="720"
                 poster={url("video/arch-glide-poster.jpg")} aria-label="The glass frontage of Blueprint Fitness Hackney, Arch 195 Morning Lane">
            <source src={url("video/arch-glide.mp4")} type="video/mp4">
            <source src={url("video/arch-glide.webm")} type="video/webm">
          </video>
        </div>
        <div class="map-frame reveal">
          <iframe src="https://maps.google.com/maps?q=Arch+195,+Morning+Lane,+London+E9+6LJ&z=15&output=embed" loading="lazy"
                  title="Map — Blueprint Fitness Hackney" referrerpolicy="no-referrer-when-downgrade"></iframe>
          <p class="map-cap"><span>E9 6LJ</span>
            <a href="https://maps.google.com/maps?q=Arch+195,+Morning+Lane,+London+E9+6LJ" rel="noopener" target="_blank">Open in Maps &rarr;</a></p>
        </div>
      </div>
      <div>
        <p class="annotation reveal">The newest one &mdash; now open</p>
        <h2 class="h-1">Hackney</h2>
        <p class="lede">Our newest studio, tucked into a railway arch just off Morning Lane. A brand-new space built for structured training and community-led coaching &mdash; same warm welcome, box-fresh kit.</p>
        <ul class="check-list">
          <li>Arch 195, Morning Lane, Hackney Central, London E9 6LJ</li>
          <li>Mon&ndash;Fri 6am&ndash;9pm &middot; Sat&ndash;Sun 8am&ndash;4pm</li>
          <li>hackney@blueprintfitnessldn.com</li>
        </ul>
        <div class="btn-row">
          <a class="btn btn-primary" href={url("kickstart/")}>Try us for 30 days</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== the numbers ===== -->
  <div class="stat-band" aria-label="Blueprint in numbers">
    <div class="container grid">
      <div class="cell"><span class="n" data-count="200" data-suffix="+">200+</span><span class="l">five-star reviews</span></div>
      <div class="cell"><span class="n" data-count="100" data-suffix="+">100+</span><span class="l">sessions a week</span></div>
      <div class="cell"><span class="n" data-count="5">5</span><span class="l">max per coach</span></div>
      <div class="cell"><span class="n" data-count="7">7</span><span class="l">days a week</span></div>
    </div>
  </div>

  <!-- CTA -->
  <section class="section on-dark section-tight">
    <div class="container" style="text-align:center;max-width:44rem">
      <h2 class="h-1">One plan. <span class="draft-u">Three doors.</span></h2>
      <p class="lede" style="margin-inline:auto">Whichever studio is closest, the first step is the same &mdash;
        come and try us for 30 days.</p>
      <p style="margin-top:1.6rem"><a class="btn btn-primary btn-big" href={url("kickstart/")}>Try us for 30 days</a></p>
    </div>
  </section>


</Base>
