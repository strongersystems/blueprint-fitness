---
/**
 * "Getting here", after Foundry's location pages: a few nearby stations as walks, or areas as drives
 * where a studio is suburban. Data and method: research/getting-here. Takes its colour from the section.
 */
import data from '../data/gettingHere.json';

interface Props { slug: string; centre?: boolean }
const { slug, centre = false } = Astro.props;
type Row = { place: string; min: number; how: 'walk' | 'drive' };
const rows = ((data as Record<string, unknown>)[slug] || []) as Row[];
---
{rows.length > 0 && (
  <div class={`getting-here reveal${centre ? ' centre' : ''}`}>
    <p class="gh-head">Getting here</p>
    <ul class="gh-list">
      {rows.map((r) => (
        <li><span class="gh-place">{r.place}</span><span class="gh-time"><b>{r.min} min</b>{' '}{r.how}</span></li>
      ))}
    </ul>
  </div>
)}
