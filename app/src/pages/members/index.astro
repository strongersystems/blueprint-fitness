---
import Base from "../../layouts/Base.astro";
import MembersNav from "../../components/MembersNav.astro";
import { url } from "../../lib/url";
---
<Base
  title={'Members — Blueprint Fitness'}
  description={'The Blueprint Fitness members area.'}
  noindex>

  <MembersNav current="hub" />


  <section class="section on-dark section-tight">
    <div class="container">
      <p class="dim sec-head" style="margin-bottom:1rem">The members area</p>
      <h1 class="h-display">Good to see you, <span class="draft-u">member.</span></h1>
      <p class="lede">Everything you need day to day, all in one place.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-2 stagger" style="align-items:stretch">
        <article class="card">
          <p class="annotation" style="margin:0 0 .3rem">How are you getting on?</p>
          <h3 class="h-3">Check-in</h3>
          <p>Tell us how training&rsquo;s going, flag a niggle or ask for help with anything at
            all, and a coach will read it and come back to you.</p>
          <p class="card-cta"><a class="btn btn-primary" href={url("members/check-in/")}>Submit a check-in</a></p>
        </article>
        <article class="card">
          <p class="annotation" style="margin:0 0 .3rem">Learn it properly, at your own pace</p>
          <h3 class="h-3">Nutrition Video Series</h3>
          <p>Twenty-two short lessons on calories, adherence, habits and what to do when progress
            stalls, in the order that matters most, and it remembers where you got to.</p>
          <p class="card-cta"><a class="btn btn-primary" href={url("members/nutrition-course/")}>Start the series</a></p>
        </article>
        <article class="card">
          <p class="annotation" style="margin:0 0 .3rem">Training is half of it</p>
          <h3 class="h-3">Nutrition consultation</h3>
          <p>Book a session with our in-house team for practical guidance built around how you
            actually live, without fad diets or meal plans to buy.</p>
          <p class="card-cta"><a class="btn btn-primary" href={url("members/nutrition-request/")}>Request a consultation</a></p>
        </article>
        <article class="card">
          <p class="annotation" style="margin:0 0 .3rem">Before you book</p>
          <h3 class="h-3">Bookings &amp; cancellations</h3>
          <p>How booking and waitlists work, the 9-hour cancellation policy and the overnight
            blackout, in plain English.</p>
          <p class="card-cta"><a class="btn btn-ghost" href={url("members/bookings-cancellations/")}>Read the policy</a></p>
        </article>
        <article class="card">
          <p class="annotation" style="margin:0 0 .3rem">The small print, made readable</p>
          <h3 class="h-3">Terms &amp; conditions</h3>
          <p>Your membership agreement with Blueprint Fitness, covering commitment, payments,
            cancellations and everything in between.</p>
          <p class="card-cta"><a class="btn btn-ghost" href={url("members/terms/")}>Read the terms</a></p>
        </article>
        <article class="card">
          <p class="annotation" style="margin:0 0 .3rem">Need to make a change?</p>
          <h3 class="h-3">Cancel or change membership</h3>
          <p>Pause, adjust or cancel your membership, or sort things out before you go on
            holiday.</p>
          <p class="card-cta"><a class="btn btn-ghost" href={url("members/cancel/")}>Make a change</a></p>
        </article>
      </div>
      <p class="annotation reveal" style="margin-top:2rem">If you can&rsquo;t find what you need, just <a href={url("contact/")} class="quiet-link">send us a message</a>.</p>
    </div>
  </section>


</Base>
