---
import Base from "../layouts/Base.astro";
import Schema from "../components/Schema.astro";
import EnquiryLightbox from "../components/EnquiryLightbox.tsx";
import { studios, kickstartPriceLine } from "../data/studios";
import { url } from "../lib/url";
---
<Base
  title={'The 30-Day Kickstart — Blueprint Fitness'}
  description={'Try Blueprint Fitness for 30 days: a coached month of small group personal training, with never more than five people per coach.'}
  minimal
  label="The 30-Day Kickstart"
  trackAll>


  <Schema slot="head" organization studios crumbs={[{ name: '30-Day Kickstart', path: '/kickstart/' }]} />
  <!-- ===== pain hook hero: the drafting board ===== -->
  <section class="hero hero-draft" data-cta-sentinel>
    <div class="hero-inner container hero-draft-grid">
      <div>
        <p class="annotation"><span class="annotation-hl">Small group personal training, across East London</span></p>
        <h1 class="h-display">
          <span class="dline"><span>Your first 30 days,</span></span>
          <span class="dline"><span>already <span class="draft-u">planned.</span></span></span>
        </h1>
        <p class="lede">Personal training in a small, supportive group of no more than five people
          per coach, with people who&rsquo;ll genuinely look after you.</p>
        <div class="btn-row" style="margin-top:1.4rem">
          <a class="btn btn-primary btn-big" data-enquiry-trigger href="#register">Get started</a>
        </div>
        <p class="hold-hint" style="margin-top:.9rem;color:#5EA2FF">12 coached sessions &middot; your plan written for you &middot; max 5 per coach</p>
        <div class="hero-stats" aria-label="The Kickstart in numbers">
          <div class="stat"><span class="n">30</span><span class="l">days, planned</span></div>
          <div class="stat"><span class="n">5:1</span><span class="l">max ratio</span></div>
          <div class="stat"><span class="n">100+</span><span class="l">sessions a week</span></div>
        </div>
      </div>
      <div class="anno-photo" aria-hidden="true">
        <img src={url("img/bf-deadlift-wall.jpg")} alt="" width="1042" height="1250">
        <div class="print-overlay" style={`background-image:url(${url("img/bf-deadlift-wall.jpg")})`}></div>
        <div class="print-head"></div>
        <span class="print-caption">a coach who knows your name</span>
      </div>
    </div>
  </section>

  <div class="ribbon" aria-hidden="true">
    <div class="track">
      <span>Small Group Personal Training</span><span>&#9679;</span>
      <span>Max 5 people per coach</span><span>&#9679;</span>
      <span>Rated 5/5 on Google from 200+ reviews</span><span>&#9679;</span>
      <span>South Woodford · Leytonstone · Hackney</span><span>&#9679;</span>
    </div>
  </div>

  <!-- ===== the problem / promise ===== -->
  <section class="section">
    <div class="container">
      <div class="h-1" data-ignite style="max-width:54rem">
        A <span class="key"><span class="hl">plan</span></span> for every session and a coach who
        makes sure you follow it, so you&rsquo;re never wandering round a gym floor or lost in a
        crowded class.
      </div>
    </div>
  </section>

  <!-- ===== benefits ===== -->
  <section class="section on-mist section-tight" id="benefits">
    <div class="container">
      <div class="sec-head">
        <p class="dim">Exactly what you get</p>
        <h2 class="h-1">What the Kickstart <span class="draft-u hl">includes</span></h2>
        <p class="lede">A whole month where everything&rsquo;s coached, so there&rsquo;s nothing to figure out on your own.</p>
      </div>
      <div class="grid-3 stagger">
        <article class="card" data-tilt>
          <div class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20v-6M6 20V10M18 20V4"/></svg></div>
          <h3 class="h-3">Your beginners&rsquo; intro session</h3>
          <p>An InBody scan and goal-setting session, where we work out exactly where you are now
            and where you want to be.</p>
        </article>
        <article class="card" data-tilt>
          <div class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm13 10v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
          <h3 class="h-3">12 coached PT sessions</h3>
          <p>Three small group personal training sessions a week, each one coached, with
            never more than five people per coach.</p>
        </article>
        <article class="card" data-tilt>
          <div class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4m0 12v4M2 12h4m12 0h4M5 5l3 3m8 8 3 3m0-14-3 3M8 16l-3 3"/></svg></div>
          <h3 class="h-3">Unlimited classes</h3>
          <p>Bigger group conditioning sessions that build a stronger heart, healthier lungs and a
            better engine, at South Woodford and Leytonstone (Hackney is coached SGPT only).</p>
        </article>
        <article class="card" data-tilt>
          <div class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6m12 5h1.5a2.5 2.5 0 0 0 0-5H18M6 2h12v7a6 6 0 0 1-12 0V2Z"/></svg></div>
          <h3 class="h-3">Weekly accountability</h3>
          <p>1-to-1 weekly check-ins with your head coach to review your progress, sessions, and
            habits outside the studio.</p>
        </article>
        <article class="card" data-tilt>
          <div class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg></div>
          <h3 class="h-3">Nutrition guidance</h3>
          <p>Practical, sensible advice from our in-house team that fits around your life, without
            any fad diets.</p>
        </article>
        <article class="card" data-tilt>
          <div class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/></svg></div>
          <h3 class="h-3">Flexible &amp; varied schedule</h3>
          <p>Over 100 coached sessions a week, early, daytime, evenings and weekends, from 6am to
            9pm.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== motion kit 3 v2: the journey primitive ===== -->
  <section class="section on-dark" id="journey">
    <div class="container">
      <div class="sec-head">
        <p class="dim">Your first month</p>
        <h2 class="h-1">Your 30 days,<br>drawn to <span class="draft-u">scale</span></h2>
        <p class="lede">We believe in habit stacking, which means getting one simple habit down
          each week before adding the next.</p>
      </div>
      <div class="journey-layout" data-daycount-track>
        <div class="journey-side">
          <div class="journey-sticky">
            <p class="annotation">You are here</p>
            <p class="daycounter" aria-hidden="true"><span data-daycount>01</span><span class="of">&nbsp;/ 30</span></p>
            <div class="plan-grid" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
              <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
              <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
            </div>
            <p class="side-note">Every box is a day trained with us, coached and planned.</p>
            <div class="plan-frame journey-side-photo">
              <img src={url("img/bf-form-fix.jpg")} alt="A Blueprint coach adjusting a member&#39;s deadlift set-up" loading="lazy" width="988" height="1436" style="aspect-ratio:4/5;object-fit:cover;object-position:center 30%">
            </div>
          </div>
        </div>
        <div class="journey">
          <div class="journey-line" aria-hidden="true"><span class="rail"></span><span class="fill"></span></div>
          <div class="journey-item">
            <span class="node" aria-hidden="true">D1</span>
            <p class="jtag">Day one: welcome in</p>
            <h3 class="h-3">Walk in and we&rsquo;ll take care of the rest.</h3>
            <p>A proper welcome, an InBody scan and a friendly chat about your goals. We&rsquo;ll
              get to know you, understand where you&rsquo;d like to be, and map out how we&rsquo;ll
              get there together.</p>
            <span class="note-tag">coach&rsquo;s note: everyone&rsquo;s a bit nervous on day one,
              and it soon passes.</span>
            <div class="plan-frame" style="aspect-ratio:16/10;max-width:30rem;margin-top:1rem">
              <img src={url("img/bf-j-planning.jpg")} alt="A Blueprint coach beside the whiteboard where the plan is written up" loading="lazy" width="1100" height="733" style="object-position:center 40%">
            </div>
          </div>
          <div class="journey-item">
            <span class="node" aria-hidden="true">W1</span>
            <p class="jtag">Week 1: finding your feet</p>
            <h3 class="h-3">Just keep showing up.</h3>
            <p>Three coached sessions, with never more than five of you to a coach, while you learn
              the movements, meet the others and get comfortable in the space. Consistency beats
              intensity, every time.</p>
            <span class="note-tag">coach&rsquo;s note: your programme&rsquo;s already written, so
              all you need to bring is yourself.</span>
            <div class="plan-frame" style="aspect-ratio:16/10;max-width:30rem;margin-top:1rem">
              <img src={url("img/bf-j-bands.jpg")} alt="A member finding her feet with band work" loading="lazy" width="1100" height="733" style="object-position:center 30%">
            </div>
          </div>
          <div class="journey-item">
            <span class="node" aria-hidden="true">W2</span>
            <p class="jtag">Week 2: proper coaching, every session</p>
            <h3 class="h-3">Personal training, in good company.</h3>
            <p>Your coach knows your name, your goals and your numbers, and adapts every exercise
              to suit you, with plenty of encouragement from the four training beside you.</p>
            <span class="note-tag">coach&rsquo;s note: we track your weights, so you never have
              to guess.</span>
            <div class="plan-frame" style="aspect-ratio:16/10;max-width:30rem;margin-top:1rem">
              <img src={url("img/bf-j-press.jpg")} alt="A Blueprint coach spotting a member through an overhead press" loading="lazy" width="1100" height="733" style="object-position:center 25%">
            </div>
          </div>
          <div class="journey-item">
            <span class="node" aria-hidden="true">W3</span>
            <p class="jtag">Week 3: habits that stick</p>
            <h3 class="h-3">The plan follows you home.</h3>
            <p>Simple habits you can keep, built one step at a time, with a weekly catch-up with
              your coach to keep everything ticking along.</p>
            <span class="note-tag">coach&rsquo;s note: one habit at a time is how they stick.</span>
            <div class="plan-frame" style="aspect-ratio:16/10;max-width:30rem;margin-top:1rem">
              <img src={url("img/bf-j-bikes.jpg")} alt="Two members laughing mid-session on the bikes" loading="lazy" width="1100" height="733" style="object-position:center 30%">
            </div>
          </div>
          <div class="journey-item">
            <span class="node" aria-hidden="true">D30</span>
            <p class="jtag">Day 30: look how far you&rsquo;ve come</p>
            <h3 class="h-3">Stronger, fitter, and sure of yourself.</h3>
            <p>We sit down together, remeasure, and celebrate what&rsquo;s changed. If you&rsquo;d
              like to stay, your next 12-week block is planned the same way, with your coach and
              your crew behind you.</p>
            <span class="note-tag">coach&rsquo;s note: this is the bit where most people say they
              wish they&rsquo;d started sooner.</span>
            <div class="plan-frame" style="aspect-ratio:16/10;max-width:30rem;margin-top:1rem">
              <img src={url("img/bf-j-rower.jpg")} alt="A member giving the rower everything, one month in" loading="lazy" width="1100" height="733" style="object-position:center 35%">
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== timetable: your week, drawn around you ===== -->
  <section class="section">
    <div class="container grid-2" style="align-items:start">
      <div>
        <div class="sec-head" style="margin-bottom:1.2rem">
          <p class="dim">The weekly timetable</p>
          <h2 class="h-1">Your 3 sessions,<br><span class="draft-u hl">your times</span></h2>
        </div>
        <p class="lede">Over 100 coached sessions run every week, from 6am to 9pm, seven days a
          week, and you pick the three that suit you best, first thing, at lunch or after
          work.</p>
        <p class="annotation">Most people find their rhythm by week two.</p>
        <div class="plan-frame reveal" style="aspect-ratio:4/3;max-width:26rem;margin-top:1.4rem">
          <img src={url("img/bf-fistbump.jpg")} alt="A coach and member sharing a fist bump mid-session" loading="lazy" width="1200" height="1800" style="object-position:center 30%">
        </div>
      </div>
      <div class="survey-sheet reveal" data-slots>
        <h3 class="h-3">When could you train?</h3>
        <div class="slot-chips">
          <button type="button" class="slot-chip" aria-pressed="false" data-label="early mornings">Early, from 6am</button>
          <button type="button" class="slot-chip" aria-pressed="false" data-label="daytimes">Daytime</button>
          <button type="button" class="slot-chip" aria-pressed="false" data-label="evenings">Evenings, till 9pm</button>
          <button type="button" class="slot-chip" aria-pressed="false" data-label="weekends">Weekends</button>
        </div>
        <p class="annotation slot-line" data-slot-line>Pick the times that suit your week and we&rsquo;ll plan around them.</p>
        <p class="small" style="color:var(--grey);margin:0">Come to whichever sessions suit you
          each week, and switch them round whenever life changes.</p>
      </div>
    </div>
  </section>

  <!-- ===== motion kit 10: the site survey (who it's for) ===== -->
  <section class="section on-mist" id="survey">
    <div class="container">
      <div class="sec-head">
        <p class="dim">The site survey</p>
        <h2 class="h-1">Every plan starts with<br>a <span class="draft-u hl">survey</span></h2>
        <p class="lede">Tick whatever sounds like you.</p>
      </div>
      <div class="survey">
        <div class="survey-sheet">
          <h3 class="h-3">This sounds like me&hellip;</h3>
          <button type="button" class="survey-item" aria-pressed="false">
            <span class="box" aria-hidden="true"><span class="tick">&#10003;</span></span>
            <span class="t"><strong>Regular gyms don&rsquo;t work for me.</strong> Crowded,
              impersonal, and nobody knows my name.</span>
          </button>
          <button type="button" class="survey-item" aria-pressed="false">
            <span class="box" aria-hidden="true"><span class="tick">&#10003;</span></span>
            <span class="t"><strong>I want expert coaching and real structure</strong> instead of
              guessing my way round a gym floor.</span>
          </button>
          <button type="button" class="survey-item" aria-pressed="false">
            <span class="box" aria-hidden="true"><span class="tick">&#10003;</span></span>
            <span class="t"><strong>I want to build strength and confidence</strong>, and
              actually feel my energy improve.</span>
          </button>
          <button type="button" class="survey-item" aria-pressed="false">
            <span class="box" aria-hidden="true"><span class="tick">&#10003;</span></span>
            <span class="t"><strong>I&rsquo;m busy.</strong> I need efficient, effective workouts
              that fit around real life.</span>
          </button>
          <button type="button" class="survey-item" aria-pressed="false">
            <span class="box" aria-hidden="true"><span class="tick">&#10003;</span></span>
            <span class="t"><strong>I&rsquo;m a beginner</strong> and I want guidance without the
              judgement.</span>
          </button>
          <div class="survey-verdict">
            <p class="annotation" data-survey-verdict>Tick what&rsquo;s true, and we&rsquo;ll be straight with you.</p>
            <a class="survey-link" href="#register">that sounds like me &rarr;</a>
          </div>
        </div>
        <div class="survey-honest">
          <div class="plan-frame" style="aspect-ratio:16/10;margin-bottom:1.2rem">
            <img src={url("img/bf-listening.jpg")} alt="A small group listening to their coach mid-session" loading="lazy" width="962" height="1458" style="object-position:center 35%">
          </div>
          <h3 class="h-3">Honestly though&hellip;</h3>
          <ul>
            <li>Every session is coached, with a programme written for you, so you&rsquo;re
              never training on your own.</li>
            <li>It suits people who&rsquo;d rather have a coach with them than open-gym access.</li>
            <li>It costs more than a budget gym, because you&rsquo;ve got a coach with you every
              session.</li>
          </ul>
          <p class="annotation">We work best with people who value professional coaching.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== one month, one price (value anchor) ===== -->
  <section class="section on-dark section-tight" id="value">
    <div class="container grid-2" style="align-items:center">
      <div>
      <div class="sec-head" style="margin-bottom:1.4rem">
        <p class="dim">One month, one price</p>
        <h2 class="h-1">Everything&rsquo;s in,<br><span class="draft-u">with nothing extra to pay.</span></h2>
      </div>
      <p class="lede">Sharing your coach with four others means the whole Kickstart is
        {kickstartPriceLine()}, around &pound;5 a day:</p>
      <ul class="check-list" style="margin:1.3rem 0 0">
        <li>Your beginners&rsquo; intro session, with an InBody scan and a proper chat about your goals</li>
        <li>12 coached PT sessions, with never more than five of you to a coach</li>
        <li>Unlimited conditioning classes at South Woodford and Leytonstone</li>
        <li>A 1-to-1 check-in with your head coach every week</li>
        <li>Practical nutrition guidance, without fad diets or meal plans to buy</li>
        <li>No joining fee or contract, and nothing else to pay</li>
      </ul>
      <p class="annotation" style="margin:1.4rem 0 1.8rem">A coach will ring you first to hear
        about your goals and find the best start for you.</p>
      <div class="btn-row" style="align-items:baseline">
        <a class="btn btn-primary btn-big" data-enquiry-trigger href="#register">Get started</a>
        <a class="quiet-link" href={url("contact/")}>or ask us anything first</a>
      </div>
      </div>
      <div class="plan-frame reveal" style="aspect-ratio:4/5;max-width:24rem;justify-self:center">
        <img src={url("img/bf-brand-tee.jpg")} alt="A Blueprint Fitness member mid-session, logo tee facing the camera" loading="lazy" width="1200" height="1800" style="object-position:center 20%">
      </div>
    </div>
  </section>

  <!-- ===== member stories: video testimonials ===== -->
  <section class="section on-dark vt" id="member-stories">
    <div class="container">
      <div class="sec-head">
        <p class="dim">Member stories</p>
        <h2 class="h-1">They started exactly <span class="draft-u">where you are</span></h2>
      </div>
      <div class="vt-grid stagger">
        <a class="vt-card" href="video/vt-rebecca.mp4" data-vt data-name="Rebecca" data-role="Blueprint member"
           data-src={url("video/vt-rebecca.mp4")} data-captions={url("video/vt-rebecca.vtt")} data-poster={url("img/vt-rebecca.jpg")}>
          <span class="vt-media"><img src={url("img/vt-rebecca.jpg")} alt="Rebecca, a Blueprint Fitness member, in the studio" loading="lazy" width="720" height="900"><span class="vt-play" aria-hidden="true"></span><span class="vt-dur">1:26</span></span>
          <span class="vt-meta"><strong>Rebecca</strong><em>&ldquo;Coaches that give you unbelievable support&hellip; and a community telling you that you&rsquo;re amazing.&rdquo;</em></span>
        </a>
        <a class="vt-card" href="video/vt-george.mp4" data-vt data-name="George" data-role="Blueprint member"
           data-src={url("video/vt-george.mp4")} data-captions={url("video/vt-george.vtt")} data-poster={url("img/vt-george.jpg")}>
          <span class="vt-media"><img src={url("img/vt-george.jpg")} alt="George, a Blueprint Fitness member, in the studio" loading="lazy" width="720" height="900"><span class="vt-play" aria-hidden="true"></span><span class="vt-dur">1:05</span></span>
          <span class="vt-meta"><strong>George</strong><em>&ldquo;I&rsquo;ve lost almost 17 stone myself.&rdquo;</em></span>
        </a>
        <a class="vt-card" href="video/vt-jayna.mp4" data-vt data-name="Jayna" data-role="Blueprint member"
           data-src={url("video/vt-jayna.mp4")} data-captions={url("video/vt-jayna.vtt")} data-poster={url("img/vt-jayna.jpg")}>
          <span class="vt-media"><img src={url("img/vt-jayna.jpg")} alt="Jayna, a Blueprint Fitness member, in front of the studio sign" loading="lazy" width="720" height="900"><span class="vt-play" aria-hidden="true"></span><span class="vt-dur">0:57</span></span>
          <span class="vt-meta"><strong>Jayna</strong><em>&ldquo;Blueprint is honestly my happy place.&rdquo;</em></span>
        </a>
        <a class="vt-card" href="video/vt-sonia.mp4" data-vt data-name="Sonia" data-role="South Woodford member"
           data-src={url("video/vt-sonia.mp4")} data-captions={url("video/vt-sonia.vtt")} data-poster={url("img/vt-sonia.jpg")}>
          <span class="vt-media"><img src={url("img/vt-sonia.jpg")} alt="Sonia, a Blueprint Fitness member, outside the South Woodford studio" loading="lazy" width="720" height="900"><span class="vt-play" aria-hidden="true"></span><span class="vt-dur">1:03</span></span>
          <span class="vt-meta"><strong>Sonia</strong><em>&ldquo;You get the individual support, but you get to train with people.&rdquo;</em></span>
        </a>
        <a class="vt-card" href="video/vt-hannah.mp4" data-vt data-name="Hannah" data-role="Leytonstone member"
           data-src={url("video/vt-hannah.mp4")} data-captions={url("video/vt-hannah.vtt")} data-poster={url("img/vt-hannah.jpg")}>
          <span class="vt-media"><img src={url("img/vt-hannah.jpg")} alt="Hannah, a Blueprint Fitness member, in the Leytonstone studio" loading="lazy" width="720" height="900"><span class="vt-play" aria-hidden="true"></span><span class="vt-dur">0:51</span></span>
          <span class="vt-meta"><strong>Hannah</strong><em>&ldquo;You always feel like you&rsquo;ve got someone&rsquo;s attention.&rdquo;</em></span>
        </a>
        <a class="vt-card" href="video/vt-adrian.mp4" data-vt data-name="Adrian" data-role="Blueprint member"
           data-src={url("video/vt-adrian.mp4")} data-captions={url("video/vt-adrian.vtt")} data-poster={url("img/vt-adrian.jpg")}>
          <span class="vt-media"><img src={url("img/vt-adrian.jpg")} alt="Adrian, a Blueprint Fitness member, mid-session" loading="lazy" width="720" height="900"><span class="vt-play" aria-hidden="true"></span><span class="vt-dur">0:41</span></span>
          <span class="vt-meta"><strong>Adrian</strong><em>&ldquo;My favourite thing about BP is the constant push.&rdquo;</em></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== all testimonials ===== -->
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <p class="dim">Google reviews</p>
