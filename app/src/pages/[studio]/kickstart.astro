---
import Base from '../../layouts/Base.astro';
import Schema from "../../components/Schema.astro";
import VideoTestimonials from '../../components/VideoTestimonials.astro';
import { studios, kickstartPerDay } from '../../data/studios';
import { site } from '../../data/site';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  return studios.map((studio) => ({ params: { studio: studio.slug }, props: { studio } }));
}
const { studio } = Astro.props;
---
<Base
  title={`30-Day Kickstart at Blueprint Fitness ${studio.name}`}
  description={`Try small group personal training at Blueprint Fitness ${studio.name}, ${studio.addressLines.join(', ')}: a coached month, with never more than ${studio.perCoachWord} people per coach.`}
  minimal label={`${studio.name} · 30-Day Kickstart`}
  trackStudios={[studio.slug]}
  ogImage={studio.heroImage}
>
  <Schema slot="head" studio={studio} crumbs={[{ name: 'Locations', path: '/locations/' }, { name: studio.name, path: `/locations/#${studio.slug}` }, { name: '30-Day Kickstart', path: `/${studio.slug}/kickstart/` }]} />
  <section class="hero hero-draft" data-cta-sentinel>
    <div class="hero-inner container hero-draft-grid">
      <div>
        <p class="annotation"><span class="annotation-hl">Small group personal training in {studio.name}</span></p>
        <h1 class="h-display">
          <span class="dline"><span>Your first 30 days,</span></span>
          <span class="dline"><span>already <span class="draft-u">planned.</span></span></span>
        </h1>
        <p class="lede">{studio.blurb}</p>
        <p class="lede">Personal training in a small, supportive group of no more than {studio.perCoachWord} people
          per coach, with people who’ll genuinely look after you.</p>
        <div class="btn-row" style="margin-top:1.4rem">
          <a class="btn btn-primary btn-big" data-start href="#register">Get started</a>
        </div>
        <p class="hold-hint" style="margin-top:.9rem;color:#5EA2FF">
          12 coached sessions · {studio.teamSessions ? 'unlimited classes · ' : ''}your plan written for you</p>
        <div class="hero-stats" aria-label="The Kickstart in numbers">
          <div class="stat"><span class="n">30</span><span class="l">days, planned</span></div>
          <div class="stat"><span class="n">{site.ratio}</span><span class="l">max ratio</span></div>
          {studio.weeklySessions && (
            <div class="stat"><span class="n">{studio.weeklySessions}</span><span class="l">sessions a week</span></div>
          )}
        </div>
      </div>
      <div class="plan-frame" style="aspect-ratio:4/5">
        <img src={url(studio.heroImage)} alt={studio.heroImageAlt} width="1400" height="1750" />
      </div>
    </div>
  </section>

  <div class="ribbon" aria-hidden="true">
    <div class="track">
      <span>Small Group Personal Training</span><span>&#9679;</span>
      <span>Max {studio.perCoach} people per coach</span><span>&#9679;</span>
      <span>Rated 5/5 on Google from 200+ reviews</span><span>&#9679;</span>
      <span>{studio.name}</span><span>&#9679;</span>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="h-1" data-ignite style="max-width:54rem">
        A <span class="key"><span class="hl">plan</span></span> for every session and a coach who
        makes sure you follow it, so you’re never wandering round a gym floor or lost in a
        crowded class.
      </div>
    </div>
  </section>

  <section class="section on-dark section-tight" id="value">
    <div class="container grid-2" style="align-items:center">
      <div>
        <div class="sec-head" style="margin-bottom:1.4rem">
          <p class="dim">One month, one price</p>
          <h2 class="h-1">Everything’s in,<br /><span class="draft-u">with nothing extra to pay.</span></h2>
        </div>
        <p class="lede">Sharing your coach with four others means the whole Kickstart is
          {studio.kickstartPrice}, which is {kickstartPerDay(studio)}:</p>
        <ul class="check-list" style="margin:1.3rem 0 0">
          <li>Your beginners’ intro session, with an InBody scan and a proper chat about your goals</li>
          <li>12 coached PT sessions, with never more than {studio.perCoachWord} of you to a coach</li>
          {studio.teamSessions && <li>Unlimited conditioning classes, {studio.openDaysLine}</li>}
          <li>A 1-to-1 check-in with your head coach every week</li>
          <li>Practical nutrition guidance, without fad diets or meal plans to buy</li>
          <li>No joining fee or contract, and nothing else to pay</li>
        </ul>
        <p class="annotation" style="margin:1.4rem 0 1.8rem">A coach from {studio.name} will ring
          you first to hear about your goals and find the best start for you.</p>
      </div>
      <div class="plan-frame reveal" style="aspect-ratio:4/5;max-width:24rem;justify-self:center">
        <img src={url('img/bf-brand-tee.jpg')} alt="A Blueprint Fitness member mid-session" loading="lazy" width="1200" height="1800" style="object-position:center 20%" />
      </div>
    </div>
  </section>

  <VideoTestimonials
    eyebrow="Member stories"
    heading='They started exactly <span class="draft-u">where you are</span>' />

  <section class="section on-dark" id="register">
    <div class="container grid-2" style="align-items:start">
      <div>
        <p class="annotation reveal">{studio.perCoachWord[0].toUpperCase() + studio.perCoachWord.slice(1)} to a coach, so everyone gets looked after</p>
        <h2 class="h-1">Ready when <span class="draft-u">you are.</span></h2>
        <p class="lede">In thirty days you’ll be stronger, fitter and sure of yourself, and the
          plan to get you there is already written.</p>
        <ul class="check-list" style="margin-top:1.4rem">
          <li>{studio.addressLines.join(', ')}, {studio.postcode}</li>
          <li>{studio.hours}</li>
          <li>{studio.email}</li>
        </ul>
      </div>
      <div class="card" style="align-self:start">
        <h3 class="h-3" style="margin:0 0 .6rem">Start at {studio.name}</h3>
        <p style="margin:0 0 1.5rem;color:#EAF1FB">Join today, book a free call with a coach
          from {studio.name}, or ask us anything first. It all starts here.</p>
        <a class="btn btn-primary btn-big" data-start href={url("contact/")} style="width:100%;justify-content:center">Get started</a>
        <p class="small" style="margin:.9rem 0 0;text-align:center;color:#EAF1FB">Already decided?
          <a href={url(`${studio.signupPath}/`)} style="color:#5EA2FF">Sign up at {studio.name} &rarr;</a></p>
      </div>
    </div>
  </section>

  <div class="sticky-cta" aria-hidden="false">
    <a class="btn btn-primary" data-start href="#register">Get started</a>
  </div>
</Base>
